#!/bin/sh /etc/rc.common
# procd service for the Incus VM agent (replaces the systemd incus-agent.service).

START=20
USE_PROCD=1

PREFIX="/run/incus_agent"

start_service() {
    /usr/libexec/incus-agent-setup | logger -t incus-agent-setup
    [ -x "${PREFIX}/incus-agent" ] || return 1

    procd_open_instance
    # The agent expects to run from its staging directory (systemd uses
    # WorkingDirectory=); procd has no equivalent, so cd in a wrapper.
    # incus-agent here may be the Incus agent loader, which mounts the
    # "agent" 9p share and replaces itself with the real binary.
    procd_set_param command /bin/sh -c "cd ${PREFIX} && exec ./incus-agent"
    # Mirrors Restart=on-failure, RestartSec=5s, StartLimitBurst=10 in 60s.
    procd_set_param respawn 60 5 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
